@page "/faculties/create"
@page "/faculties/{Id:int}/edit"
@attribute [Authorize(Roles = UserRoles.Admin)]
@using SyllabusApp.Application.Dtos.Faculties
@using SyllabusApp.Application.Dtos.Locations
@using SyllabusApp.Web.Services.ApiClients
@inject FacultyApiClient FacultyApiClient
@inject LocationApiClient LocationApiClient
@inject NavigationManager Navigation

<PageTitle>@(Id.HasValue ? "Edytuj wydział" : "Nowy wydział")</PageTitle>

<h1 class="text-2xl font-semibold text-slate-800">@(Id.HasValue ? "Edytuj wydział" : "Nowy wydział")</h1>

@if (_loading)
{
    <p class="mt-4 text-slate-500">Ładowanie...</p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="mt-6 max-w-lg space-y-4">
        <DataAnnotationsValidator />

        <div>
            <label class="form-label">Nazwa</label>
            <InputText @bind-Value="_model.Name" class="form-input" />
            <ValidationMessage For="@(() => _model.Name)" class="form-error" />
        </div>

        <div>
            <label class="form-label">Kod</label>
            <InputText @bind-Value="_model.Code" class="form-input" />
            <ValidationMessage For="@(() => _model.Code)" class="form-error" />
        </div>

        <div>
            <label class="form-label">Lokalizacja</label>
            <InputSelect @bind-Value="_model.LocationId" class="form-input">
                <option value="0">-- wybierz --</option>
                @foreach (var location in _locations)
                {
                    <option value="@location.Id">@location.Name (@location.City)</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => _model.LocationId)" class="form-error" />
        </div>

        @if (_errorMessage != null)
        {
            <div class="rounded bg-red-50 px-3 py-2 text-sm text-red-700">@_errorMessage</div>
        }

        <div class="flex gap-3">
            <button type="submit" class="btn-primary" disabled="@_isSubmitting">
                @(_isSubmitting ? "Zapisywanie..." : "Zapisz")
            </button>
            <a href="/faculties" class="btn-secondary">Anuluj</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private readonly CreateFacultyDto _model = new();
    private List<LocationDto> _locations = [];
    private bool _loading;
    private bool _isSubmitting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _locations = await LocationApiClient.GetAllAsync();

        if (Id.HasValue)
        {
            var existing = await FacultyApiClient.GetByIdAsync(Id.Value);
            if (existing != null)
            {
                _model.Name = existing.Name;
                _model.Code = existing.Code;
                _model.LocationId = existing.LocationId;
            }
        }

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        var success = Id.HasValue
            ? await UpdateAsync(Id.Value)
            : await CreateAsync();

        _isSubmitting = false;

        if (success)
        {
            Navigation.NavigateTo("/faculties");
        }
    }

    private async Task<bool> CreateAsync()
    {
        var result = await FacultyApiClient.CreateAsync(_model);
        _errorMessage = result.Success ? null : result.ErrorMessage;
        return result.Success;
    }

    private async Task<bool> UpdateAsync(int id)
    {
        var dto = new UpdateFacultyDto
        {
            Name = _model.Name,
            Code = _model.Code,
            LocationId = _model.LocationId,
        };

        var result = await FacultyApiClient.UpdateAsync(id, dto);
        _errorMessage = result.Success ? null : result.ErrorMessage;
        return result.Success;
    }
}
