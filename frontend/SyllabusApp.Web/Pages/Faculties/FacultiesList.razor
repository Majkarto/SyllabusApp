@page "/faculties"
@attribute [Authorize]
@using SyllabusApp.Application.Dtos.Faculties
@using SyllabusApp.Web.Services.ApiClients
@inject FacultyApiClient FacultyApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Wydziały</PageTitle>

<div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-800">Wydziały</h1>
    <AuthorizeView Roles="@UserRoles.Admin">
        <Authorized>
            <a href="/faculties/create" class="btn-primary">+ Dodaj wydział</a>
        </Authorized>
    </AuthorizeView>
</div>

@if (_errorMessage != null)
{
    <div class="mt-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700">@_errorMessage</div>
}

@if (_faculties == null)
{
    <p class="mt-4 text-slate-500">Ładowanie...</p>
}
else if (_faculties.Count == 0)
{
    <p class="mt-4 text-slate-500">Brak wydziałów.</p>
}
else
{
    <div class="mt-4 overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Kod</th>
                    <th>Lokalizacja</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var faculty in _faculties)
                {
                    <tr>
                        <td>@faculty.Name</td>
                        <td>@faculty.Code</td>
                        <td>@faculty.LocationName (@faculty.LocationCity)</td>
                        <td class="text-right">
                            <AuthorizeView Roles="@UserRoles.Admin">
                                <Authorized>
                                    <a href="/faculties/@faculty.Id/edit" class="text-blue-600 hover:underline">Edytuj</a>
                                    <button type="button" class="ml-3 text-red-600 hover:underline" @onclick="() => DeleteAsync(faculty)">Usuń</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<FacultyDto>? _faculties;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _faculties = await FacultyApiClient.GetAllAsync();
    }

    private async Task DeleteAsync(FacultyDto faculty)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Usunąć wydział „{faculty.Name}”?");
        if (!confirmed)
        {
            return;
        }

        var result = await FacultyApiClient.DeleteAsync(faculty.Id);
        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _errorMessage = null;
        await LoadAsync();
    }
}
