@page "/fields-of-study"
@attribute [Authorize]
@using SyllabusApp.Application.Dtos.FieldOfStudies
@using SyllabusApp.Web.Services.ApiClients
@inject FieldOfStudyApiClient FieldOfStudyApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Kierunki studiów</PageTitle>

<div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-800">Kierunki studiów</h1>
    <AuthorizeView Roles="@UserRoles.Admin">
        <Authorized>
            <a href="/fields-of-study/create" class="btn-primary">+ Dodaj kierunek</a>
        </Authorized>
    </AuthorizeView>
</div>

@if (_errorMessage != null)
{
    <div class="mt-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700">@_errorMessage</div>
}

@if (_fieldsOfStudy == null)
{
    <p class="mt-4 text-slate-500">Ładowanie...</p>
}
else if (_fieldsOfStudy.Count == 0)
{
    <p class="mt-4 text-slate-500">Brak kierunków studiów.</p>
}
else
{
    <div class="mt-4 overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Kod</th>
                    <th>Poziom</th>
                    <th>Semestry</th>
                    <th>Wydział</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fieldOfStudy in _fieldsOfStudy)
                {
                    <tr>
                        <td>@fieldOfStudy.Name</td>
                        <td>@fieldOfStudy.Code</td>
                        <td>@fieldOfStudy.Level</td>
                        <td>@fieldOfStudy.DurationSemesters</td>
                        <td>@fieldOfStudy.FacultyName (@fieldOfStudy.FacultyCode)</td>
                        <td class="text-right">
                            <AuthorizeView Roles="@UserRoles.Admin">
                                <Authorized>
                                    <a href="/fields-of-study/@fieldOfStudy.Id/edit" class="text-blue-600 hover:underline">Edytuj</a>
                                    <button type="button" class="ml-3 text-red-600 hover:underline" @onclick="() => DeleteAsync(fieldOfStudy)">Usuń</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<FieldOfStudyDto>? _fieldsOfStudy;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _fieldsOfStudy = await FieldOfStudyApiClient.GetAllAsync();
    }

    private async Task DeleteAsync(FieldOfStudyDto fieldOfStudy)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Usunąć kierunek „{fieldOfStudy.Name}”?");
        if (!confirmed)
        {
            return;
        }

        var result = await FieldOfStudyApiClient.DeleteAsync(fieldOfStudy.Id);
        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _errorMessage = null;
        await LoadAsync();
    }
}
