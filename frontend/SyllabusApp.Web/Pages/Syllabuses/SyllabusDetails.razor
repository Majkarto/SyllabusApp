@page "/syllabuses/{Id:int}"
@attribute [Authorize]
@using SyllabusApp.Application.Dtos.Syllabuses
@using SyllabusApp.Application.Dtos.LearningOutcomes
@using SyllabusApp.Application.Dtos.Literatures
@using SyllabusApp.Application.Dtos.WorkloadItems
@using SyllabusApp.Application.Dtos.SyllabusVersions
@using SyllabusApp.Application.Validation
@using SyllabusApp.Domain.Entities
@using SyllabusApp.Web.Services.ApiClients
@inject SyllabusApiClient SyllabusApiClient
@inject LearningOutcomeApiClient LearningOutcomeApiClient
@inject LiteratureApiClient LiteratureApiClient
@inject WorkloadItemApiClient WorkloadItemApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Sylabus</PageTitle>

@if (_syllabus == null)
{
    <p class="text-slate-500">Ładowanie...</p>
}
else
{
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-semibold text-slate-800">@_syllabus.CourseName - @_syllabus.AcademicYear</h1>
        <div class="flex gap-2">
            <button type="button" class="btn-secondary" @onclick='() => ExportAsync("pdf")'>Eksport PDF</button>
            <button type="button" class="btn-secondary" @onclick='() => ExportAsync("docx")'>Eksport DOCX</button>
            <AuthorizeView Roles="@($"{UserRoles.Admin},{UserRoles.Lecturer}")">
                <Authorized>
                    <a href="/syllabuses/@Id/edit" class="btn-primary">Edytuj dane sylabusa</a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <dl class="mt-6 grid grid-cols-2 gap-x-8 gap-y-3 rounded-lg border border-slate-200 bg-white p-6 text-sm md:grid-cols-4">
        <div><dt class="text-slate-500">Kod przedmiotu</dt><dd class="font-medium text-slate-800">@_syllabus.CourseCode</dd></div>
        <div><dt class="text-slate-500">Kierunek</dt><dd class="font-medium text-slate-800">@_syllabus.FieldOfStudyName</dd></div>
        <div><dt class="text-slate-500">Ośrodek</dt><dd class="font-medium text-slate-800">@_syllabus.LocationName</dd></div>
        <div><dt class="text-slate-500">Semestr</dt><dd class="font-medium text-slate-800">@_syllabus.Semester</dd></div>
        <div><dt class="text-slate-500">Status</dt><dd class="font-medium text-slate-800">@Labels.Status(_syllabus.Status)</dd></div>
        <div><dt class="text-slate-500">Wersja</dt><dd class="font-medium text-slate-800">v@(_syllabus.CurrentVersion)</dd></div>
        <div><dt class="text-slate-500">ECTS</dt><dd class="font-medium text-slate-800">@_syllabus.EctsPoints</dd></div>
        <div><dt class="text-slate-500">Wykłady (h)</dt><dd class="font-medium text-slate-800">@_syllabus.LectureHours</dd></div>
        <div><dt class="text-slate-500">Ćwiczenia (h)</dt><dd class="font-medium text-slate-800">@_syllabus.ExerciseHours</dd></div>
        <div><dt class="text-slate-500">Laboratoria (h)</dt><dd class="font-medium text-slate-800">@_syllabus.LaboratoryHours</dd></div>
        <div class="col-span-2 md:col-span-4"><dt class="text-slate-500">Opis przedmiotu</dt><dd class="text-slate-800">@(string.IsNullOrWhiteSpace(_syllabus.Description) ? "-" : _syllabus.Description)</dd></div>
        <div class="col-span-2 md:col-span-4"><dt class="text-slate-500">Cel zajęć</dt><dd class="text-slate-800">@_syllabus.CourseObjectives</dd></div>
        <div class="col-span-2 md:col-span-4"><dt class="text-slate-500">Metoda oceny</dt><dd class="text-slate-800">@_syllabus.AssessmentMethod</dd></div>
        <div class="col-span-2 md:col-span-4"><dt class="text-slate-500">Warunki wstępne</dt><dd class="text-slate-800">@_syllabus.Prerequisites</dd></div>
    </dl>

    @if (_errorMessage != null)
    {
        <div class="mt-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700">@_errorMessage</div>
    }

    <!-- Efekty uczenia się -->
    <section class="mt-8">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-slate-800">Efekty uczenia się</h2>
            <AuthorizeView Roles="@($"{UserRoles.Admin},{UserRoles.Lecturer}")">
                <Authorized>
                    <button type="button" class="btn-secondary" @onclick="() => _showLearningOutcomeForm = !_showLearningOutcomeForm">
                        @(_showLearningOutcomeForm ? "Anuluj" : "+ Dodaj efekt")
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>

        @if (_showLearningOutcomeForm)
        {
            <EditForm Model="_newLearningOutcome" OnValidSubmit="AddLearningOutcomeAsync" class="mt-3 grid grid-cols-1 gap-3 rounded border border-slate-200 bg-white p-4 md:grid-cols-4">
                <DataAnnotationsValidator />
                <div>
                    <label class="form-label">Kod</label>
                    <InputText @bind-Value="_newLearningOutcome.Code" class="form-input" />
                </div>
                <div class="md:col-span-2">
                    <label class="form-label">Opis</label>
                    <InputText @bind-Value="_newLearningOutcome.Description" class="form-input" />
                </div>
                <div>
                    <label class="form-label">Kategoria</label>
                    <InputSelect @bind-Value="_newLearningOutcome.Category" class="form-input">
                        @foreach (var category in Enum.GetValues<LearningOutcomeCategory>())
                        {
                            <option value="@category">@Labels.Category(category)</option>
                        }
                    </InputSelect>
                </div>
                <div class="md:col-span-4">
                    <button type="submit" class="btn-primary">Dodaj</button>
                </div>
            </EditForm>
        }

        @if (_learningOutcomes.Count == 0)
        {
            <p class="mt-3 text-sm text-slate-500">Brak efektów uczenia się.</p>
        }
        else
        {
            <table class="data-table mt-3">
                <thead>
                    <tr><th>Kod</th><th>Opis</th><th>Kategoria</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var outcome in _learningOutcomes)
                    {
                        <tr>
                            <td>@outcome.Code</td>
                            <td>@outcome.Description</td>
                            <td>@Labels.Category(outcome.Category)</td>
                            <td class="text-right">
                                <AuthorizeView Roles="@($"{UserRoles.Admin},{UserRoles.Lecturer}")">
                                    <Authorized>
                                        <button type="button" class="text-red-600 hover:underline" @onclick="() => DeleteLearningOutcomeAsync(outcome)">Usuń</button>
                                    </Authorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <!-- Literatura -->
    <section class="mt-8">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-slate-800">Literatura</h2>
            <AuthorizeView Roles="@($"{UserRoles.Admin},{UserRoles.Lecturer}")">
                <Authorized>
                    <button type="button" class="btn-secondary" @onclick="() => _showLiteratureForm = !_showLiteratureForm">
                        @(_showLiteratureForm ? "Anuluj" : "+ Dodaj pozycję")
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>

        @if (_showLiteratureForm)
        {
            <EditForm Model="_newLiterature" OnValidSubmit="AddLiteratureAsync" class="mt-3 grid grid-cols-1 gap-3 rounded border border-slate-200 bg-white p-4 md:grid-cols-4">
                <DataAnnotationsValidator />
                <div>
                    <label class="form-label">Tytuł</label>
                    <InputText @bind-Value="_newLiterature.Title" class="form-input" />
                </div>
                <div>
                    <label class="form-label">Autor</label>
                    <InputText @bind-Value="_newLiterature.Author" class="form-input" />
                </div>
                <div>
                    <label class="form-label">Wydawca</label>
                    <InputText @bind-Value="_newLiterature.Publisher" class="form-input" />
                </div>
                <div>
                    <label class="form-label">Rodzaj</label>
                    <InputSelect @bind-Value="_newLiterature.Type" class="form-input">
                        @foreach (var type in Enum.GetValues<LiteratureType>())
                        {
                            <option value="@type">@Labels.Literature(type)</option>
                        }
                    </InputSelect>
                </div>
                <div class="md:col-span-4">
                    <button type="submit" class="btn-primary">Dodaj</button>
                </div>
            </EditForm>
        }

        @if (_literature.Count == 0)
        {
            <p class="mt-3 text-sm text-slate-500">Brak pozycji literatury.</p>
        }
        else
        {
            <table class="data-table mt-3">
                <thead>
                    <tr><th>Tytuł</th><th>Autor</th><th>Wydawca</th><th>Rodzaj</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var item in _literature)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.Author</td>
                            <td>@item.Publisher</td>
                            <td>@Labels.Literature(item.Type)</td>
                            <td class="text-right">
                                <AuthorizeView Roles="@($"{UserRoles.Admin},{UserRoles.Lecturer}")">
                                    <Authorized>
                                        <button type="button" class="text-red-600 hover:underline" @onclick="() => DeleteLiteratureAsync(item)">Usuń</button>
                                    </Authorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <!-- Nakład pracy -->
    <section class="mt-8">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-slate-800">Nakład pracy studenta</h2>
            <AuthorizeView Roles="@($"{UserRoles.Admin},{UserRoles.Lecturer}")">
                <Authorized>
                    <button type="button" class="btn-secondary" @onclick="() => _showWorkloadItemForm = !_showWorkloadItemForm">
                        @(_showWorkloadItemForm ? "Anuluj" : "+ Dodaj pozycję")
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>

        @if (_showWorkloadItemForm)
        {
            <EditForm Model="_newWorkloadItem" OnValidSubmit="AddWorkloadItemAsync" class="mt-3 grid grid-cols-1 gap-3 rounded border border-slate-200 bg-white p-4 md:grid-cols-4">
                <DataAnnotationsValidator />
                <div class="md:col-span-2">
                    <label class="form-label">Opis</label>
                    <InputText @bind-Value="_newWorkloadItem.Description" class="form-input" />
                </div>
                <div>
                    <label class="form-label">Godziny</label>
                    <InputNumber @bind-Value="_newWorkloadItem.Hours" class="form-input" />
                </div>
                <div>
                    <label class="form-label">Typ</label>
                    <InputSelect @bind-Value="_newWorkloadItem.Type" class="form-input">
                        @foreach (var type in Enum.GetValues<WorkloadType>())
                        {
                            <option value="@type">@Labels.Workload(type)</option>
                        }
                    </InputSelect>
                </div>
                <div class="md:col-span-4">
                    <button type="submit" class="btn-primary">Dodaj</button>
                </div>
            </EditForm>
        }

        @if (_workloadItems.Count > 0)
        {
            var totalHours = _workloadItems.Sum(w => w.Hours);
            var warning = SyllabusRules.CheckWorkload(_syllabus.EctsPoints, totalHours);
            <div class="mt-3 rounded px-3 py-2 text-sm @(warning == null ? "bg-green-50 text-green-700" : "bg-amber-50 text-amber-800")">
                @(warning ?? $"Łączny nakład pracy: {totalHours} h - zgodny z {_syllabus.EctsPoints} ECTS.")
            </div>
        }

        @if (_workloadItems.Count == 0)
        {
            <p class="mt-3 text-sm text-slate-500">Brak pozycji nakładu pracy.</p>
        }
        else
        {
            <table class="data-table mt-3">
                <thead>
                    <tr><th>Opis</th><th>Godziny</th><th>Typ</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var item in _workloadItems)
                    {
                        <tr>
                            <td>@item.Description</td>
                            <td>@item.Hours</td>
                            <td>@Labels.Workload(item.Type)</td>
                            <td class="text-right">
                                <AuthorizeView Roles="@($"{UserRoles.Admin},{UserRoles.Lecturer}")">
                                    <Authorized>
                                        <button type="button" class="text-red-600 hover:underline" @onclick="() => DeleteWorkloadItemAsync(item)">Usuń</button>
                                    </Authorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <!-- Historia wersji -->
    <section class="mt-8">
        <h2 class="text-lg font-semibold text-slate-800">Historia zmian</h2>
        @if (_versions.Count == 0)
        {
            <p class="mt-3 text-sm text-slate-500">Brak zapisanych wersji.</p>
        }
        else
        {
            <table class="data-table mt-3">
                <thead>
                    <tr><th>Wersja</th><th>Data</th><th>Autor</th><th>Opis zmian</th><th>Rok</th><th>ECTS</th><th>W/Ć/L (h)</th></tr>
                </thead>
                <tbody>
                    @foreach (var version in _versions)
                    {
                        <tr>
                            <td>v@(version.VersionNumber)</td>
                            <td>@version.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(version.CreatedByName ?? "-")</td>
                            <td>@version.ChangeDescription</td>
                            <td>@version.AcademicYear</td>
                            <td>@version.EctsPoints</td>
                            <td>@version.LectureHours / @version.ExerciseHours / @version.LaboratoryHours</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private SyllabusDto? _syllabus;
    private List<LearningOutcomeDto> _learningOutcomes = [];
    private List<LiteratureDto> _literature = [];
    private List<WorkloadItemDto> _workloadItems = [];
    private List<SyllabusVersionDto> _versions = [];
    private string? _errorMessage;

    private bool _showLearningOutcomeForm;
    private bool _showLiteratureForm;
    private bool _showWorkloadItemForm;

    // Enumy startują od 1 (0 to "brak wartości") - <InputSelect> renderuje pierwszą opcję jako
    // wizualnie zaznaczoną, ale bez jawnego ustawienia tutaj powiązany model zostaje przy
    // default(enum)=0, dopóki użytkownik ręcznie nie kliknie w select.
    private CreateLearningOutcomeDto _newLearningOutcome = new() { Category = LearningOutcomeCategory.Knowledge };
    private CreateLiteratureDto _newLiterature = new() { Type = LiteratureType.Required };
    private CreateWorkloadItemDto _newWorkloadItem = new() { Type = WorkloadType.Contact };

    protected override async Task OnInitializedAsync()
    {
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        _syllabus = await SyllabusApiClient.GetByIdAsync(Id);

        var allLearningOutcomes = await LearningOutcomeApiClient.GetAllAsync();
        _learningOutcomes = allLearningOutcomes.Where(o => o.SyllabusId == Id).ToList();

        var allLiterature = await LiteratureApiClient.GetAllAsync();
        _literature = allLiterature.Where(l => l.SyllabusId == Id).ToList();

        var allWorkloadItems = await WorkloadItemApiClient.GetAllAsync();
        _workloadItems = allWorkloadItems.Where(w => w.SyllabusId == Id).ToList();

        _versions = await SyllabusApiClient.GetVersionsAsync(Id);
    }

    private async Task ExportAsync(string format)
    {
        var result = await SyllabusApiClient.ExportAsync(Id, format);
        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        var contentType = format == "pdf"
            ? "application/pdf"
            : "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
        var fileName = $"sylabus-{_syllabus!.CourseCode}-{_syllabus.AcademicYear.Replace('/', '-')}.{format}";
        await JsRuntime.InvokeVoidAsync("downloadFile", fileName, contentType, Convert.ToBase64String(result.Data!));
    }

    private async Task AddLearningOutcomeAsync()
    {
        _newLearningOutcome.SyllabusId = Id;
        var result = await LearningOutcomeApiClient.CreateAsync(_newLearningOutcome);
        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _errorMessage = null;
        _newLearningOutcome = new CreateLearningOutcomeDto { Category = LearningOutcomeCategory.Knowledge };
        _showLearningOutcomeForm = false;
        await LoadAllAsync();
    }

    private async Task DeleteLearningOutcomeAsync(LearningOutcomeDto outcome)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Usunąć efekt „{outcome.Code}”?");
        if (!confirmed)
        {
            return;
        }

        var result = await LearningOutcomeApiClient.DeleteAsync(outcome.Id);
        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _errorMessage = null;
        await LoadAllAsync();
    }

    private async Task AddLiteratureAsync()
    {
        _newLiterature.SyllabusId = Id;
        var result = await LiteratureApiClient.CreateAsync(_newLiterature);
        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _errorMessage = null;
        _newLiterature = new CreateLiteratureDto { Type = LiteratureType.Required };
        _showLiteratureForm = false;
        await LoadAllAsync();
    }

    private async Task DeleteLiteratureAsync(LiteratureDto item)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Usunąć pozycję „{item.Title}”?");
        if (!confirmed)
        {
            return;
        }

        var result = await LiteratureApiClient.DeleteAsync(item.Id);
        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _errorMessage = null;
        await LoadAllAsync();
    }

    private async Task AddWorkloadItemAsync()
    {
        _newWorkloadItem.SyllabusId = Id;
        var result = await WorkloadItemApiClient.CreateAsync(_newWorkloadItem);
        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _errorMessage = null;
        _newWorkloadItem = new CreateWorkloadItemDto { Type = WorkloadType.Contact };
        _showWorkloadItemForm = false;
        await LoadAllAsync();
    }

    private async Task DeleteWorkloadItemAsync(WorkloadItemDto item)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Usunąć pozycję „{item.Description}”?");
        if (!confirmed)
        {
            return;
        }

        var result = await WorkloadItemApiClient.DeleteAsync(item.Id);
        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _errorMessage = null;
        await LoadAllAsync();
    }
}
