@page "/locations"
@attribute [Authorize]
@using SyllabusApp.Application.Dtos.Locations
@using SyllabusApp.Web.Services.ApiClients
@inject LocationApiClient LocationApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Lokalizacje</PageTitle>

<div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-800">Lokalizacje</h1>
    <AuthorizeView Roles="@UserRoles.Admin">
        <Authorized>
            <a href="/locations/create" class="btn-primary">+ Dodaj lokalizację</a>
        </Authorized>
    </AuthorizeView>
</div>

@if (_errorMessage != null)
{
    <div class="mt-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700">@_errorMessage</div>
}

@if (_locations == null)
{
    <p class="mt-4 text-slate-500">Ładowanie...</p>
}
else if (_locations.Count == 0)
{
    <p class="mt-4 text-slate-500">Brak lokalizacji.</p>
}
else
{
    <div class="mt-4 overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Adres</th>
                    <th>Miasto</th>
                    <th>Kod pocztowy</th>
                    <th>Budynek</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var location in _locations)
                {
                    <tr>
                        <td>@location.Name</td>
                        <td>@location.Address</td>
                        <td>@location.City</td>
                        <td>@location.PostalCode</td>
                        <td>@location.BuildingCode</td>
                        <td class="text-right">
                            <AuthorizeView Roles="@UserRoles.Admin">
                                <Authorized>
                                    <a href="/locations/@location.Id/edit" class="text-blue-600 hover:underline">Edytuj</a>
                                    <button type="button" class="ml-3 text-red-600 hover:underline" @onclick="() => DeleteAsync(location)">Usuń</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<LocationDto>? _locations;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _locations = await LocationApiClient.GetAllAsync();
    }

    private async Task DeleteAsync(LocationDto location)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Usunąć lokalizację „{location.Name}”?");
        if (!confirmed)
        {
            return;
        }

        var result = await LocationApiClient.DeleteAsync(location.Id);
        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _errorMessage = null;
        await LoadAsync();
    }
}
